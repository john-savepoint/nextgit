{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextgit-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    "AUTH_MODE": "demo",
    "EVIDENCE_PUBLIC_KEY": "<base64url raw public key — attestation-keygen.mjs>"
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "nextgit"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "consumers": [
      {
        "queue": "nextgit-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "LIVE",
      "id": "9850d064f5bc43649125b9d8e9e130d2"
    },
    {
      "binding": "CACHE",
      "id": "55d973240e2d4770a07ddc0faedf757c"
    },
    {
      "binding": "REVEAL_AUDIT",
      "id": "8aa1ccbca22a46d19b0230066d3256cc"
    },
    {
      "binding": "SKIP_RECORD",
      "id": "704420fc54f54c47a0c3bf76280fca78"
    }
  ],
  "r2_buckets": [
    { "binding": "ASSET_BLOB", "bucket_name": "nextgit-asset-blobs" },
    { "binding": "EVIDENCE_BLOB", "bucket_name": "nextgit-evidence" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS"
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "LAND_LEASE", "class_name": "LandLeaseDO" },
      { "name": "EVENTS_HUB", "class_name": "EventsHubDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LandLeaseDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "EventsHubDO"
      ]
    }
  ]
}
