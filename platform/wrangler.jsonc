{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextgit-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "nextgit"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "consumers": [
      {
        "queue": "nextgit-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "LIVE",
      "id": "9850d064f5bc43649125b9d8e9e130d2"
    },
    {
      "binding": "CACHE",
      "id": "55d973240e2d4770a07ddc0faedf757c"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LAND_LEASE", "class_name": "LandLeaseDO" },
      { "name": "EVENTS_HUB", "class_name": "EventsHubDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LandLeaseDO",
        "EventsHubDO"
      ]
    }
  ]
}
