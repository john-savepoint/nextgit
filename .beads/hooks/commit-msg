#!/usr/bin/env bash
# commit-msg hook — strip AI Co-Authored-By trailers before commit
#
# This hook sanitizes the commit message file ($1) by removing any
# Co-Authored-By trailer lines. Works regardless of whether
# Claude Code settings.json has attribution disabled — belt-and-braces.
#
# The hook runs AFTER the user writes the message but BEFORE the commit
# is finalized. If all lines are removed, the commit is aborted.

set -euo pipefail

COMMIT_MSG_FILE="$1"

# Patterns to strip (pipe-separated regex)
STRIP_RE='^Co-Authored-By:.*anthropic\.com>|^Co-authored-by:.*anthropic\.com>|^Co-Authored-By: Claude' 

# Strip matching lines, preserving everything else
if grep -qiE 'Co-Authored-By.*anthropic' "$COMMIT_MSG_FILE" 2>/dev/null; then
    # Create backup of original message for reference
    # (only while debugging — remove once stable)
    # cp "$COMMIT_MSG_FILE" "${COMMIT_MSG_FILE}.pre-strip"

    sed -i -E "/${STRIP_RE}/Id" "$COMMIT_MSG_FILE"
    echo "[commit-msg hook] Stripped Co-Authored-By trailer(s) from commit message" >&2
fi

# If the commit message is now empty (only blank lines remain), abort
if ! grep -q '[^[:space:]]' "$COMMIT_MSG_FILE"; then
    echo "ERROR: commit message empty after stripping Co-Authored-By." >&2
    exit 1
fi

exit 0
